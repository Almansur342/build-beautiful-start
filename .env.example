# Qrinux LeadLens — environment variable reference
# Copy to .env and fill in real values. NEVER commit real secrets.
#
# ---------------- Public (browser-safe, VITE_*) ----------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
#
# ---------------- Server-only (backend / server functions) ------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # PRIVILEGED — never expose to VITE_* or client
SUPABASE_PROJECT_ID=
SUPABASE_DB_URL=                 # PRIVILEGED — server-only
LOVABLE_API_KEY=                 # PRIVILEGED — server-only
